# Image to text. Get a key at https://aistudio.google.com (leave blank to only blur).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Your site's address, comma separated if more than one. "*" allows any site.
ALLOWED_ORIGINS=https://yoursite.com

# Optional tuning. Lower numbers catch more and blur more.
# FACE_THRESHOLD=0.4
# PLATE_THRESHOLD=0.5
# Faces narrower than this many pixels are left alone: too small to recognize anyone,
# and most "faces" that small are specks. Raise it if photos still report faces that aren't there.
# FACE_MIN_PX=10
