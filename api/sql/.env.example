# Tiger Cloud connection string, from the service's "Connect" page. Include the password.
DATABASE_URL="postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require"

# ----- Report agent (optional). Without GEMINI_API_KEY the form has no "fill in from photo", and the
# department and the message for a new ticket come from fixed rules and a plain template. -----
# Gemini: photo analysis, choosing the department, and report writing. Key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=""
# How hard Gemini thinks before answering. "low" (the default) is quickest; "" uses the model's own default.
# GEMINI_THINKING_LEVEL="low"
# How many seconds a slow Gemini answer is given before giving up.
# GEMINI_TIMEOUT_SECONDS="45"

# Microsoft Foundry: the agent that runs the steps. Without these, the server runs the same steps itself.
# Full agent (needs a login made for the server with `az ad sp create-for-rbac`):
# FOUNDRY_PROJECT_ENDPOINT="https://<resource>.services.ai.azure.com/api/projects/<project>"
# AZURE_TENANT_ID=""
# AZURE_CLIENT_ID=""
# AZURE_CLIENT_SECRET=""
# Or, when that login can't be created, the model with a key:
# FOUNDRY_OPENAI_URL="https://<resource>.openai.azure.com/openai/v1/"
# FOUNDRY_API_KEY=""
# Either way:
# FOUNDRY_MODEL="gpt-5-mini"
# FOUNDRY_REASONING_EFFORT="low"
# How many seconds to wait for the agent once a report is ready, before returning it without the agent.
# FOUNDRY_GRACE_SECONDS="12"

# ----- Photo privacy (optional). Blurs faces and license plates before a photo is stored. -----
# Where the photo privacy service (photo-privacy/ folder) is running. On the live server
# deploy.sh sets this by itself. With it set, an upload is refused if the service is down.
# PHOTO_PRIVACY_URL="http://127.0.0.1:8001"
